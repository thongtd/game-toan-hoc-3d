{
  "name": "math-runner-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Đường đua Toán học 3D - mini game web 3D luyện Toán cho học sinh tiểu học",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run server/tests/repository-contract.test.ts",
    "test:api": "vitest run server/tests/api.test.ts",
    "test:e2e": "playwright test",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:thumbnails": "node scripts/capture-map-thumbnails.mjs",
    "server:dev": "node --watch server/src/index.ts",
    "server:start": "node server/src/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run server:build"
  },
  "dependencies": {
    "howler": "2.2.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/howler": "2.2.13",
    "@types/node": "24.10.1",
    "@types/three": "0.185.4",
    "eslint": "10.8.1",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
