# Prettier is configured with endOfLine=lf, so the repository stores LF and
# Git normalises on checkout. Without this, a Windows checkout (autocrlf=true)
# rewrites every file to CRLF and `npm run format:check` fails on a clean tree.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.webp binary
*.ogg binary
*.glb binary
*.ttf binary
*.db binary
*.zip binary
