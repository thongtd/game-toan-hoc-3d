# Cấu hình máy chủ. Copy thành .env rồi sửa cho môi trường của bạn.
# Không commit .env thật.

# --------------------------------- Storage ---------------------------------
# sqlite (mặc định, khuyến nghị) hoặc json (demo/local, một tiến trình).
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/math-runner.db
JSON_DATA_PATH=./data/math-runner.json

# --------------------------------- Bảo mật ---------------------------------
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự. Production sẽ từ chối khởi động nếu thiếu.
# Tạo nhanh: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PLAYER_TOKEN_PEPPER=replace-with-a-long-random-secret-at-least-32-chars

# Danh sách origin được phép, cách nhau bằng dấu phẩy. Không dùng "*" ở production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Đặt true khi chạy sau reverse proxy (nginx, Caddy) để đọc X-Forwarded-For.
TRUST_PROXY=false

# ---------------------------------- Mạng -----------------------------------
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# --------------------------------- Frontend --------------------------------
# Dùng khi build web. Mặc định gọi cùng origin qua /api/v1.
# VITE_API_BASE_URL=http://127.0.0.1:8787/api/v1

# Deploy vào thư mục con thì đặt base path, ví dụ /game/.
# VITE_BASE_PATH=/

# Cho phép chơi thử không xếp hạng khi backend lỗi. Mặc định tắt.
# VITE_ALLOW_PRACTICE_OFFLINE=false

# Bật cầu nối debug cho E2E. Chỉ dùng cho bản build test.
# VITE_ENABLE_GAME_DEBUG=false
